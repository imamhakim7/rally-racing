{
  "name": "apex-rally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apex Rally — browser rally game built on three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "bun run build && bun scripts/screenshot.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.2"
  }
}
